# Public origin of THIS server (no trailing slash). Must match the URL
# entered in claude.ai Connectors / Cursor mcp.json / Grok MCP config.
MCP_ISSUER_URL=https://mcp.example.com

# Comma-separated redirect URIs allowed to DCR. Defaults include Claude
# Connectors + Cursor plugin MCP localhost:8787. Add your own.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:8787/callback

# Grok CLI/TUI uses http://127.0.0.1:<ephemeral>/callback. Kill that surface
# if you are not using Grok: MCP_ALLOW_LOOPBACK=0
# MCP_ALLOW_LOOPBACK=1

# allowlist (default) | disabled (static client only; breaks claude.ai UI)
# MCP_DCR_MODE=allowlist

# Optional pin after first legitimate connect (trust-on-first-use).
# MCP_ALLOWED_CLIENT_ID=

# License (required unless MCP_OAUTH_DEV=1)
# MCP_OAUTH_DEV=1
# MCP_OAUTH_LICENSE_KEY=
# MCP_OAUTH_LICENSE_SECRET=   # only on the machine that ISSUES keys
